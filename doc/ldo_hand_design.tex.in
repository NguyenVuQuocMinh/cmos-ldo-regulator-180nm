\label{tab:par}
\begin{tabular}{lccccc}
\toprule
& $L = 0.18\,\mu$m & 0.5 & 1 & 2 & 3\\
\midrule
NMOS $V_{TH}$ (V) & <<P['n_L0.18']['VTH']|.3f>> & <<P['n_L0.50']['VTH']|.3f>> & <<P['n_L1.00']['VTH']|.3f>> & <<P['n_L2.00']['VTH']|.3f>> & <<P['n_L3.00']['VTH']|.3f>>\\
NMOS $\KP$ ($\mu$A/V$^2$) & <<P['n_L0.18']['KP']*1e6|.0f>> & <<P['n_L0.50']['KP']*1e6|.0f>> & <<P['n_L1.00']['KP']*1e6|.0f>> & <<P['n_L2.00']['KP']*1e6|.0f>> & <<P['n_L3.00']['KP']*1e6|.0f>>\\
