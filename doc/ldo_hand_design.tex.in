\end{table}

\begin{itemize}[itemsep=0.2ex]
\item \textbf{v1} ($L = 1\,\mu$m everywhere) is stable, with a large margin, but its EA gain is only
<<D1['heavy']['A_ea']|.0f>> against <<V1['A_ea']|.0f>> by hand. As a result, PSRR and line regulation miss.
\item \textbf{v2} doubles $L$ for $M_1$--$M_4$. The gain rises, but by Proposition~\ref{T-prop:pea} $p_{EA}$
falls (it scales as $\lambda/L$), and the phase margin with $\RESR = 0$ drops to
<<C2['pm_esr0_min']|.1f>>$^\circ$ at $\VIN = 1.9$\,V, 85\,$^\circ$C. At light load and $\VIN = 1.9$\,V, $\VEA$
also rises to within <<(SP['VREF']+P['p_L1.00']['VTH']) - O2['vinmax_light']['v(ea)']|.2f>>\,V of the bound $\VREF+|V_{TH,p}|$ of
Proposition~\ref{T-prop:window}. $M_2$ then nears triode and the PSRR falls to <<C2['psrr_nom_min']|.1f>>\,dB.
\item \textbf{v3} applies both results.
\begin{itemize}[itemsep=0.1ex]
\item The simulated operating point shows that $g_{ds4}$, not $g_{ds2}$, dominates the EA output
conductance. v3 therefore lengthens only the mirror ($L_{34} = 3\,\mu$m) and keeps the wide input pair
short ($L_{12} = 1\,\mu$m), so $C_{EA}$ stays small.
\item $V_{OV,B}$ is moved to the centre of the headroom window \eqref{T-eq:window}.
\end{itemize}
\end{itemize}

\subsection{Results of the final design}
\begin{figure}[H]
\centering
\includegraphics[width=0.74\textwidth]{figures/loop_gain_v3.png}
\caption{Loop gain $T$ at four loads. The DC gain is about 52--60\,dB, $\fu$ moves from
<<S3['loop']['0.1mA']['UGF']/1e3|.1f>>\,kHz to <<S3['loop']['50mA']['UGF']/1e3|.0f>>\,kHz with load (Proposition~\ref{T-prop:fu}), and
the PM is <<S3['loop']['50mA']['PM']|.1f>>$^\circ$ at the worst (full) load.}
\label{fig:loop}
\end{figure}

\begin{figure}[H]
\centering
\includegraphics[width=0.49\textwidth]{figures/psrr_v3.png}\hfill
\includegraphics[width=0.49\textwidth]{figures/pm_vs_esr_v3.png}
\caption{Left: PSRR. It is flat at about $G$ up to the loop bandwidth, as predicted by \eqref{T-eq:psrr}; above
$\fu$ the capacitor $\CL$ takes over. Right: phase margin versus $\RESR$. The margin first rises (zero
lead), peaks near 100\,m$\Omega$, then collapses as the plateau of Proposition~\ref{T-prop:esr} pushes $\fu$
toward $p_B$, $p_{EA}$. It stays above 45$^\circ$ up to 200\,m$\Omega$ and is <<S3['esr']['50mA'][7][1]|.0f>>$^\circ$ at
500\,m$\Omega$.}
